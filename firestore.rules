rules_version = '2';

// SnagemV3 Firestore security rules. This is the REAL authorization layer —
// the app's checks are UI only. See docs/PERMISSIONS.md.
// Paste this whole file into Firebase console -> Firestore Database -> Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function selfExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function self() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return selfExists() && self().permissions == 'Admin';
    }
    function hasCap(cap) {
      return isAdmin() || (selfExists() && cap in self().get('capabilities', []));
    }
    // A field is "unchanged" if the incoming write keeps its current value.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---- Approved members --------------------------------------------------
    // permissions/capabilities/badges are Admin-only; a user may edit the rest
    // of their own doc (settings, myBookmarks, profile fields, etc).
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin();            // promotion from NewUsers is admin/console only
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid
        && unchanged('permissions')
        && unchanged('capabilities')
        && unchanged('badges')
      );

      // Item bag: owner manages own; GiveItems (or Admin) may grant into any bag.
      match /bag/items {
        allow read: if request.auth.uid == uid || isAdmin();
        allow write: if request.auth.uid == uid || hasCap('GiveItems');
      }
      // Badge ownership is admin-granted and display state changes go through
      // the setBadgeEnabled Cloud Function (which also syncs users.badges) —
      // so badges are read-only for the owner. Note the generic bag rule
      // below excludes 'badges'; overlapping rules are OR'd in Firestore.
      match /bag/badges {
        allow read: if request.auth.uid == uid || isAdmin();
        allow write: if isAdmin();
      }
      // All other per-user data: owner (or admin) only.
      match /bag/{doc} {
        allow read: if request.auth.uid == uid || isAdmin();
        allow write: if isAdmin() || (request.auth.uid == uid && doc != 'badges');
      }
      match /bookmarks/{doc} {
        allow read, write: if request.auth.uid == uid || isAdmin();
      }
      match /drafts/{doc} {
        allow read, write: if request.auth.uid == uid || isAdmin();
      }
    }

    // ---- Registration queue ------------------------------------------------
    // Owner creates their own pending doc with permissions pinned to "New".
    match /NewUsers/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.permissions == 'New';
      allow update, delete: if isAdmin();
    }

    // ---- Admin-managed shared data ----------------------------------------
    match /admin/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasCap('ManageLists');
    }

    // ---- Discord link requests --------------------------------------------
    match /tickets/{doc} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    // ---- Append-only audit trail ------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Forums ------------------------------------------------------------
    // All publishing (threads, posts, rolls, votes, boss battles, inventory
    // effects) goes through Cloud Functions (functions/src/index.ts), which
    // use the Admin SDK and bypass these rules. Clients keep exactly two
    // direct write paths, locked to specific fields via diff():
    //   1. bookmark subscribe/unsubscribe -> notifyviaDiscord only
    //   2. the thread host editing details -> title/instructions/tags/
    //      restricted/allowedPosters/encounterConfig/closed only
    // Everything else is admin-only (console escape hatch).
    match /forum/{forum} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /threads/{threadId} {
        allow read: if isSignedIn();
        allow create: if isAdmin();   // publishForumThread enforces the category matrix
        allow update: if isAdmin()
          || (isSignedIn()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['notifyviaDiscord']))
          || (isSignedIn()
              && request.auth.uid == resource.data.get('hostUid', '')
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['title', 'instructions', 'tags', 'restricted',
                             'allowedPosters', 'encounterConfig', 'closed']));
        allow delete: if isAdmin();

        // Posts are written exclusively by publishForumPost / setBossBattle —
        // dice, randoms, encounters and item blocks are server-generated and
        // therefore write-once by construction.
        match /posts/{postId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isAdmin();
        }

        // Server-rolled results bound to the player's next post. Read-own so
        // the composer can restore them after a reload; never client-written.
        match /pending/{uid} {
          allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
          allow write: if false;
        }
      }
    }
  }
}
