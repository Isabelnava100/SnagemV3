rules_version = '2';

// SnagemV3 Firestore security rules. This is the REAL authorization layer;
// the app's checks are UI only. See docs/PERMISSIONS.md.
// Paste this whole file into Firebase console -> Firestore Database -> Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function selfExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function self() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return selfExists() && self().permissions == 'Admin';
    }
    function hasCap(cap) {
      return isAdmin() || (selfExists() && cap in self().get('capabilities', []));
    }
    // A field is "unchanged" if the incoming write keeps its current value.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---- Approved members --------------------------------------------------
    // permissions/capabilities/badges are Admin-only; a user may edit the rest
    // of their own doc (settings, myBookmarks, profile fields, etc).
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin();            // promotion from NewUsers is admin/console only
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid
        && unchanged('permissions')
        && unchanged('capabilities')
        && unchanged('badges')
      );

      // Item bag: spends/grants go through Cloud Functions (buy, craft, recycle,
      // evolve, candy->scent, mystery box) which run with the Admin SDK. Direct
      // client writes are limited to GiveItems/Admin grants (the Donate tool);
      // owners can no longer hand-edit their own inventory quantities.
      match /bag/items {
        allow read: if request.auth.uid == uid || isAdmin();
        allow write: if isAdmin() || hasCap('GiveItems');
      }
      // Badge ownership is granted by staff and display state changes go
      // through the setBadgeEnabled Cloud Function (which also syncs
      // users.badges), so badges are read-only for the owner. Admins and
      // ManageBadges directors may assign/revoke. Note the generic bag rule
      // below excludes 'badges'; overlapping rules are OR'd in Firestore.
      match /bag/badges {
        allow read: if request.auth.uid == uid || isAdmin();
        allow write: if isAdmin() || hasCap('ManageBadges');
      }
      // Public-profile subset: WORLD-readable so logged-out visitors can view
      // profiles (see docs/PROFILE_DATA.md). These hold no PII. The user doc
      // itself stays members-only (it has email + discordUID); its world-safe
      // display fields are mirrored into the public publicProfiles/{uid} doc.
      // Writes stay owner/admin. Currency, items, bookmarks, drafts and
      // notifications remain private via the rules above/below.
      match /bag/profile {
        allow read: if true;
        allow write: if isAdmin() || request.auth.uid == uid;
      }
      match /bag/characters {
        allow read: if true;
        allow write: if isAdmin() || request.auth.uid == uid;
      }
      // Owned Pokemon: caught, evolved, trained and character-assigned only via
      // Cloud Functions (Admin SDK), so members cannot self-edit experience,
      // species or shiny state. World-readable for public profiles (no PII).
      match /bag/owned_pokemons {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /bag/teams {
        allow read: if true;
        allow write: if isAdmin() || request.auth.uid == uid;
      }
      // Currency is money: written ONLY by the server (shop/casino/recycle/craft
      // callables run with the Admin SDK, which bypasses rules) or by GiveItems
      // grants. Never owner-writable, so members cannot mint their own coins.
      // Without this explicit rule the generic bag rule below would let them.
      match /bag/currency {
        allow read: if request.auth.uid == uid || isAdmin();
        allow write: if isAdmin() || hasCap('GiveItems');
      }
      // All other per-user data: owner (or admin) only. Note bag/items stays
      // owner-writable because the client-side evolution flow decrements a spend
      // item there; closing that fully means moving evolvePokemon to a callable.
      // 'snaglist' (the weekly activities checklist) and 'daycare' (the
      // breeding pair + egg timer) are excluded: only the Cloud Functions
      // write them, so members cannot check their own boxes or forge an egg.
      match /bag/{doc} {
        allow read: if request.auth.uid == uid || isAdmin();
        allow write: if isAdmin()
                     || (request.auth.uid == uid
                         && doc != 'badges' && doc != 'snaglist' && doc != 'daycare');
      }
      match /bookmarks/{doc} {
        allow read, write: if request.auth.uid == uid || isAdmin();
      }
      match /drafts/{doc} {
        allow read, write: if request.auth.uid == uid || isAdmin();
      }
      // In-app notifications: created by Cloud Functions only; the owner can
      // read them, mark them read, and delete them.
      match /notifications/{noteId} {
        allow read, update, delete: if request.auth.uid == uid || isAdmin();
        allow create: if false;
      }
    }

    // ---- Registration queue ------------------------------------------------
    // Owner creates their own pending doc with permissions pinned to "New".
    match /NewUsers/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.permissions == 'New';
      allow update, delete: if isAdmin();
    }

    // ---- One-time Gaia usernames ------------------------------------------
    // Each GaiaOnline guild name can back only ONE account. The doc id is the
    // normalized name; it is create-once (updates denied), so a second signup
    // with the same Gaia name fails at the rules layer. Registration writes it
    // right after the auth account is made. Admins can free a claim.
    match /gaiaClaims/{name} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Safari Contest template (admin/safari_config): star pools + rates that an
    // event host confirms and launches. Event hosts and list managers may edit
    // it (the specific match widens the generic admin rule below via OR).
    match /admin/safari_config {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasCap('HostEvents') || hasCap('ManageLists');
    }

    // ---- Admin-managed shared data ----------------------------------------
    // Includes the badge catalog (admin/badges); ManageBadges may edit it.
    match /admin/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || hasCap('ManageLists') || hasCap('ManageBadges')
                   || hasCap('ManageSEO');
    }

    // Sensitive integration config (Discord client secret, webhook URL). Admin
    // only for BOTH read and write; the Cloud Functions read it via the Admin
    // SDK, so no signed-in read is ever needed here.
    match /adminSecrets/{doc} {
      allow read, write: if isAdmin();
    }

    // ---- Discord link requests --------------------------------------------
    match /tickets/{doc} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    // ---- Dev Board (admin collab) -----------------------------------------
    // Development tickets and admin-to-admin planning notes, managed from
    // Admin > Manage > Dev Board. Member suggestions/bug reports arrive via
    // the tickets collection (written by S.N.A.G.) and are promoted here.
    match /devBoard/{doc} {
      allow read, write: if isAdmin();
    }

    // ---- Poke Swap trades (written by callables; parties may read) --------
    match /trades/{doc} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid ||
         resource.data.toUid == request.auth.uid || isAdmin());
    }

    // ---- Thread-close reward sessions ---------------------------------------
    // Draft state for awarding money/items/XP when a thread closes. Reward
    // granters (GiveItems / Admin) and ReviewRewards directors can see or edit;
    // applying the rewards goes through the finalizeThreadRewards Cloud Function.
    match /rewardSessions/{sessionId} {
      allow read, write: if hasCap('GiveItems') || hasCap('ReviewRewards');
    }

    // ---- Returning-member data imports (Gaia onboarding) -------------------
    // The member builds and submits their own request; reviewers (Admin /
    // ApproveImports) can read the queue. Applying the grant and any
    // reviewer-side status change go through the approveImport / rejectImport
    // Cloud Functions (Admin SDK), so clients never write another member's doc
    // or their own bag here.
    match /importRequests/{uid} {
      allow read: if request.auth.uid == uid || isAdmin() || hasCap('ApproveImports');
      allow create, update: if request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- Append-only audit trail ------------------------------------------
    // Staff (admins and any director with a capability) can read the trail so
    // it can render at the approval screens they work in.
    match /auditLogs/{logId} {
      allow read: if isAdmin()
                  || (selfExists() && self().get('capabilities', []).size() > 0);
      allow create: if isSignedIn()
                    && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Snag Mall / Missions catalogs ------------------------------------
    // Read-only reference data for members. Seeded + edited by admins; all
    // spend/write actions (buy, craft, recycle, tour, revive, grade) go through
    // Cloud Functions with the Admin SDK, so clients never write these.
    // World-safe mirror of each member's display fields (username, avatar,
    // badges, role, signature, emojis). Written only by the syncPublicProfile
    // Cloud Function; never carries email or Discord. Public so logged-out
    // visitors can view profiles.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /shops/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /recipes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /missions/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Lore Library: worldbuilding content, member-readable. Edited by admins or
    // directors granted ManageLore (mirrors canManageLore in the app).
    match /loreBooks/{id} {
      allow read: if isSignedIn();
      allow write: if hasCap('ManageLore');
    }
    match /loreEntries/{id} {
      allow read: if isSignedIn();
      allow write: if hasCap('ManageLore');
    }

    // Mission submissions + Master Mission requests: created and graded by
    // Cloud Functions (Admin SDK). A member may read their own; graders/admins
    // may read all. Direct client writes are denied.
    match /missionSubmissions/{id} {
      allow read: if isSignedIn()
                  && (resource.data.submitterUid == request.auth.uid
                      || isAdmin() || hasCap('ReviewRewards'));
      allow write: if false;
    }
    match /masterMissionRequests/{id} {
      allow read: if isSignedIn()
                  && (resource.data.uid == request.auth.uid
                      || isAdmin() || hasCap('ReviewRewards'));
      allow write: if false;
    }
    // Master-track clearance requests: created by requestMasterClearance and
    // resolved by resolveMasterClearance (Cloud Functions). Read own or grader.
    match /masterClearanceRequests/{id} {
      allow read: if isSignedIn()
                  && (resource.data.uid == request.auth.uid
                      || isAdmin() || hasCap('ReviewRewards'));
      allow write: if false;
    }

    // ---- Colosseum + Challenges -------------------------------------------
    // Read-only reference/leaderboard data for members. Rankings and per-member
    // challenge progress are written by Cloud Functions (Admin SDK); catalogs
    // (hall of fame, tournaments, gym regions, island trials) are admin-edited.
    match /battle_rankings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /hall_of_fame/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /tournaments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // Sign-ups: a member creates/edits/deletes only their own entry
      // (doc id == their uid); admins can manage any. Friend codes live here,
      // under the tournament, not on the public profile.
      match /signups/{uid} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || request.auth.uid == uid;
      }
    }
    match /gymRegions/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // Challenge run requests: created and resolved by Cloud Functions
    // (requestChallenge / resolveChallengeRequest). A member reads their own;
    // hosting/grading staff read the queue. Direct client writes are denied.
    match /challengeRequests/{id} {
      allow read: if isSignedIn()
                  && (resource.data.uid == request.auth.uid
                      || isAdmin() || hasCap('HostMainForum') || hasCap('ReviewRewards'));
      allow write: if false;
    }
    match /islandTrials/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Casino: lotto state is member-readable (jackpot/draw); all writes (tickets,
    // draws, exchanges, plays) go through server-side RNG Cloud Functions.
    match /casino/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Collection-group reads for the dashboard History tab: a member may query
    // their OWN posts and threads across every forum at once. Other members'
    // documents stay behind the explicit /forum path rules below (overlapping
    // rules are OR'd, so this only widens reads for the author).
    match /{path=**}/posts/{postId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /{path=**}/threads/{threadId} {
      allow read: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }

    // ---- Forums ------------------------------------------------------------
    // All publishing (threads, posts, rolls, votes, boss battles, inventory
    // effects) goes through Cloud Functions (functions/src/index.ts), which
    // use the Admin SDK and bypass these rules. Clients keep exactly two
    // direct write paths, locked to specific fields via diff():
    //   1. bookmark subscribe/unsubscribe -> notifyviaDiscord only
    //   2. the thread host editing details -> title/instructions/tags/
    //      restricted/allowedPosters/encounterConfig/closed only
    // Everything else is admin-only (console escape hatch).
    match /forum/{forum} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /threads/{threadId} {
        allow read: if isSignedIn();
        allow create: if isAdmin();   // publishForumThread enforces the category matrix
        allow update: if isAdmin()
          || (isSignedIn()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['notifyviaDiscord', 'watcherUids']))
          || (isSignedIn()
              && request.auth.uid == resource.data.get('hostUid', '')
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['title', 'instructions', 'tags', 'restricted',
                             'allowedPosters', 'encounterConfig', 'closed',
                             'xpAward', 'xpConfig']))
          // Reward-granting directors may close (archive) any thread: closed only.
          || ((hasCap('GiveItems') || hasCap('ReviewRewards'))
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['closed']));
        allow delete: if isAdmin();

        // Posts are written exclusively by publishForumPost / setBossBattle.
        // Dice, randoms, encounters and item blocks are server-generated and
        // therefore write-once by construction.
        match /posts/{postId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isAdmin();
        }

        // Server-rolled results bound to the player's next post. Read-own so
        // the composer can restore them after a reload; never client-written.
        match /pending/{uid} {
          allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
          allow write: if false;
        }
      }
    }
  }
}
